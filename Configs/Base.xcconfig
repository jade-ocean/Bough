// Base.xcconfig - shared build baseline for both configurations.
// Debug/Release each #include this file so both share one baseline.

// Swift 5 language mode on a 5.9+ compiler; avoids Swift 6 strict-concurrency churn in skeleton phase.
SWIFT_VERSION = 5.0
// SwiftData requires macOS 14+ (confirmed decision: drop Ventura).
MACOSX_DEPLOYMENT_TARGET = 14.0
MARKETING_VERSION = 0.4.0
CURRENT_PROJECT_VERSION = 6
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_EMIT_LOC_STRINGS = YES
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
GCC_NO_COMMON_BLOCKS = YES
